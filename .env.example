# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# BASE DE DATOS POSTGRESQL (NEON)
# ==========================================
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?sslmode=require

# ==========================================
# SEGURIDAD JWT
# ==========================================
JWT_SECRET=<GENERAR_SECRETO_ALEATORIO_LARGO>

# ==========================================
# CONFIGURACIÓN DE EMAIL (Brevo)
# ==========================================
BREVO_API_KEY=<BREVO_API_KEY>
BREVO_SENDER_EMAIL=<EMAIL_REMITENTE>

# ==========================================
# FRONTEND / BACKEND URL
# ==========================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==========================================
# POOL DE CONEXIONES NEON (opcional)
# ==========================================
PG_MAX_CONNECTIONS=10
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=10000

# ==========================================
# GITHUB (backups vía Actions)
# ==========================================
GITHUB_TOKEN=<GITHUB_TOKEN>

# ==========================================
# CLOUDINARY (imágenes)
# ==========================================
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# ==========================================
# STRIPE (Pagos)
# ==========================================
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_PUBLISHABLE_KEY=<STRIPE_PUBLISHABLE_KEY>
